<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><parent><groupId>kr.seremc</groupId><artifactId>custom-nickname-parent</artifactId><version>2.0.0-SNAPSHOT</version></parent><artifactId>custom-nickname-velocity</artifactId>
  <dependencies>
    <dependency><groupId>kr.seremc</groupId><artifactId>custom-nickname-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.velocitypowered</groupId><artifactId>velocity-api</artifactId><version>3.4.0-SNAPSHOT</version><scope>provided</scope></dependency>
    <dependency><groupId>com.github.NEZNAMY</groupId><artifactId>TAB-API</artifactId><version>6.1.2</version><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><annotationProcessorPaths><path><groupId>com.velocitypowered</groupId><artifactId>velocity-api</artifactId><version>3.4.0-SNAPSHOT</version></path></annotationProcessorPaths></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
      <createDependencyReducedPom>false</createDependencyReducedPom>
      <artifactSet><excludes><exclude>org.slf4j:slf4j-api</exclude><exclude>com.github.NEZNAMY:TAB-API</exclude></excludes></artifactSet>
      <relocations>
        <relocation><pattern>com.zaxxer.hikari</pattern><shadedPattern>kr.seremc.nickname.libs.hikari</shadedPattern></relocation>
        <relocation><pattern>org.mariadb.jdbc</pattern><shadedPattern>kr.seremc.nickname.libs.mariadb</shadedPattern></relocation>
      </relocations>
      <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter></filters>
      <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
    </configuration></execution></executions></plugin>
  </plugins></build>
</project>
